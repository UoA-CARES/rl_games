        </mxCell>
        <mxCell id="e2lbl" value="extends" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="230" y="318" width="60" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== RIGHT: call flow ===================== -->
        <mxCell id="title-right" value="Call flow, one epoch" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="360" height="30" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="train()  —  loops forever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="train_epoch()  —  once per epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="f3" value="play_steps()  —  ROLLOUT phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="320" height="45" as="geometry" />
        </mxCell>

        <mxCell id="f4" value="get_action_values()  x horizon_length steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="280" height="40" as="geometry" />
        </mxCell>

        <mxCell id="f5" value="calc_gradients()  —  UPDATE phase&#10;x (mini_epochs_num  x  num_minibatches)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="335" width="320" height="55" as="geometry" />
